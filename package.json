{
  "name": "@apnex/operation-command",
  "version": "0.1.0",
  "private": true,
  "description": "Run one declared invocation from a command line, reporting its ending through the exit status.",
  "license": "MIT",
  "author": "apnex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apnex/operation-command.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./process": {
      "types": "./dist/process-adapter.d.ts",
      "default": "./dist/process-adapter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "docs:check": "tools/check-docs.sh"
  },
  "dependencies": {
    "@apnex/operation-call": "https://github.com/apnex/operation-call/releases/download/v0.1.0/apnex-operation-call-0.1.0.tgz",
    "@apnex/shape-check": "https://github.com/apnex/shape-check/releases/download/v0.1.0/apnex-shape-check-0.1.0.tgz"
  },
  "devDependencies": {
    "@agp/core": "file:../agp/packages/core",
    "@agp/node": "file:../agp/packages/node",
    "@agp/transport-loopback": "file:../agp/packages/transport-loopback",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
